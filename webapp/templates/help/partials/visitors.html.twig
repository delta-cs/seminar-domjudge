{% extends 'help/partials/base.html.twig' %}

{% set id = 'Visitors' %}

{% block header %}
    For visitors
{% endblock %}

{% block body %}
    <p>
        The site is divided into these pages:
    </p>
    <ul>
        <li>news: articles and updates from the course of the seminar,</li>
        <li>scoreboard: the participants' results and their progress through the problems,</li>
        <li>problemset: the current set of problems,</li>
        <li>study: a link to the problem statements and study materials of the current year,</li>
        <li>archive: a link to the source code of all past problems.</li>
    </ul>
    <p>
        The top right corner shows the time left for the current problem set, and there you can also switch between
        the practice and the competition problems (this affects the Scoreboard and Problemset pages).
    </p>
    <img src="{{ asset('images/help/contests.png') }}" alt="Switching contests" class="mb-3 rounded-3 help-img">
{% endblock %}
