{% extends 'help/partials/base.html.twig' %}

{% set id = 'Communication' %}

{% block header %}
    Communication
{% endblock %}

{% block body %}
    <p>
        During the seminar we will send participants informational messages.
        They appear in the Messages section of the Team page.
    </p>
    <img src="{{ asset('images/help/messages.png') }}" alt="Messages" class="mb-3 rounded-3 img-fluid help-img">
    <p>
        Unread messages are shown in yellow in the navigation bar.
    </p>
    <img src="{{ asset('images/help/messages-unread.png') }}" alt="Unread messages"
         class="mb-3 rounded-3 img-fluid help-img">
    <p>
        You may need to clarify a problem statement or a judging result. If anything is unclear, do not hesitate to
        get in touch: use the button in the Clarification Request section under Messages.
    </p>
    <img src="{{ asset('images/help/clarification-request.png') }}" alt="Clarification request"
         class="mb-3 rounded-3 img-fluid help-img">
    <p>
        The answer will arrive in the same section.
    </p>

    {% if discord_invite_url is not empty %}
        <p>
            You can also visit our <a target="_blank" href="{{ discord_invite_url }}">Discord</a>
            and ask there.
        </p>
    {% endif %}
{% endblock %}
