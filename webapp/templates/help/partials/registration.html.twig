{% extends 'help/partials/base.html.twig' %}

{% set id = 'Registration' %}

{% block header %}
    Registration
{% endblock %}

{% block body %}
    <p>
        To take part in the seminar, you first need to <a href="{{ path('register') }}">register</a>.
        Choosing your school is required.
        If your school is not in the list yet, switch to "Add new school" and create it.
    </p>
    <img src="{{ asset('images/help/register.png') }}" alt="Registration" class="mb-3 rounded-3 img-fluid help-img">
    <p>
        Then <a href="{{ path('login') }}">log in</a> with your details.
    </p>
{% endblock %}
