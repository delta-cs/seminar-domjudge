{% extends is_granted('ROLE_TEAM') ? "team/base.html.twig" : "public/base.html.twig" %}

{% block extrahead %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset("css/help.css") }}">
{% endblock %}

{% block content %}
    <div class="container">
        <h1>{{ 'Help' | trans }}</h1>
        <p>
            {{ 'This page explains how to find your way around the site and how to compete.' | trans }}
        </p>
        <div class="accordion">
            {# The partials are prose, so English has its own copy (*.en.html.twig) next to the Czech one. #}
            {% for part in ['visitors', 'registration', 'forgotten_password', 'problemset', 'submissions', 'scoreboard', 'communication'] %}
                {% include ['help/partials/' ~ part ~ '.' ~ app.request.locale ~ '.html.twig', 'help/partials/' ~ part ~ '.html.twig'] %}
            {% endfor %}
        </div>
    </div>
{% endblock %}
