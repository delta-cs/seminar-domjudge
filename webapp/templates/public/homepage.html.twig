{% extends "public/base.html.twig" %}

{% block extrahead %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset("css/blog.css") }}">
    <link rel="stylesheet" href="{{ asset("css/homepage.css") }}">
{% endblock %}

{% block body %}
    {# The page is prose, so each language has its own copy of the content. #}
    {% include ['public/partials/homepage_content.' ~ app.request.locale ~ '.html.twig', 'public/partials/homepage_content.html.twig'] %}
{% endblock %}
