{% if judging is empty or (not showTooLateResult and judging.submission.submittime >= current_team_contest.endtime) or (verificationRequired and not judging.verified) %}
    <div class="alert alert-danger">{{ 'Submission not found for this team or not judged yet.' | trans }}</div>
{% else %}
    <div class="container">
        {% if not judging.valid %}
            <div class="alert alert-warning">{{ 'This submission is being ignored. It is not used in determining your score.' | trans }}
            </div>
        {% endif %}

        <div class="d-flex flex-row">
            <div class="p-2">
                {{ 'Problem:' | trans }}
                <b>
                        <span class="probid">
                            {{ judging.submission.contestProblem.shortname }}</span> -
                    {{ judging.submission.contestProblem.problem.name }}
                </b>
            </div>
            <div class="p-2">
                {{ 'Submitted:' | trans }}
                <b>{{ judging.submission.submittime | printtime(null, current_team_contest) }}</b>
            </div>
            <div class="p-2">
                {{ 'Language:' | trans }}
                <b>{{ judging.submission.language.name }}</b>
            </div>
            {% if not showCompile %}
                <div class="p-2">
                    {{ 'Compilation:' | trans }}
                    {% if judging.result == 'compiler-error' %}
                        <span class="badge text-bg-danger">{{ 'failed' | trans }}</span>
                    {% else %}
                        <span class="badge text-bg-success">{{ 'successful' | trans }}</span>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {% if judging.result != 'compiler-error' %}
            <div class="d-flex flex-row">
                <div class="p-2">
                    {{ 'Result:' | trans }} {{ judging.result | printResult }}
                    {% if judging.result | resultExplanation %}
                        <div class="small text-body-secondary mt-1" id="resultExplanation">{{ judging.result | resultExplanation | trans }}</div>
                    {% endif %}
                </div>
                {% if judging.result == 'correct' and judging.submission.contest.getRuntimeAsScoreTiebreaker() %}
                    <div class="p-2">
                        {{ 'Max. Runtime:' | trans }} <b>{{ "%0.3f s" | format(judging.getMaxRuntime()) }}</b>
                    </div>
                {% endif %}
            </div>
        {% endif %}

        {% if hiddenTests is defined and hiddenTests is not null %}
            {% set notRunNote = hiddenTests.notRun > 0
                ? ' ' ~ ('%count% did not run, because judging stopped at the first failed test.' | trans({'%count%': hiddenTests.notRun}))
                : '' %}
            <div class="p-2" id="hiddenTestSummary">
                {% if hiddenTests.failed > 0 and hiddenTests.samplesFailed == 0 %}
                    <div class="alert alert-warning mb-0">
                        {# The counts are integers, so the translated sentence can keep its <b> markup. #}
                        {{ 'All sample tests passed, but your program failed on hidden tests: <b>%failed% of %total%</b> failed.' | trans({'%failed%': hiddenTests.failed, '%total%': hiddenTests.total}) | raw }}{{ notRunNote }}
                    </div>
                {% elseif hiddenTests.failed > 0 %}
                    {{ 'Hidden tests: <b>%failed% of %total%</b> failed.' | trans({'%failed%': hiddenTests.failed, '%total%': hiddenTests.total}) | raw }}{{ notRunNote }}
                {% elseif hiddenTests.notRun == 0 %}
                    {{ 'Hidden tests: all <b>%total%</b> passed.' | trans({'%total%': hiddenTests.total}) | raw }}
                {% elseif hiddenTests.passed == 0 %}
                    {{ 'Hidden tests: not run, because judging stopped at the first failed test.' | trans }}
                {% else %}
                    {{ 'Hidden tests: <b>%passed% of %total%</b> passed.' | trans({'%passed%': hiddenTests.passed, '%total%': hiddenTests.total}) | raw }}{{ notRunNote }}
                {% endif %}
            </div>
        {% endif %}

        {% if judging.pointsScored is not null %}
            <div>
                <div class="p-2">
                    {{ 'You scored %scored% out of %max% points.' | trans({'%scored%': judging.pointsScored, '%max%': judging.submission.contestProblem.points}) }}
                    <div class="progress" style="width: 300px">
                        <div class="progress-bar bg-success" role="progressbar"
                             style="width: {{ judging.pointsScored * 100 / judging.submission.contestProblem.points }}%"
                             aria-valuenow="{{ judging.pointsScored }}" aria-valuemin="0"
                             aria-valuemax="{{ judging.submission.contestProblem.points }}"></div>
                    </div>
                </div>
            </div>
        {% endif %}

        {% if allowDownload %}
            <div class="d-flex flex-row">
                <div class="p-2">
                    <a title="{{ 'Download submission ZIP' | trans }}" aria-label="{{ 'Download submission ZIP' | trans }}" class="btn" href="{{ path('team_submission_download', {'submitId': judging.submission.submitid}) }}">
                        <i class="fa fa-file-archive"></i> {{ 'Download submission ZIP' | trans }}
                    </a>
                </div>
            </div>
        {% endif %}

        {% if showCompile %}
            <hr/>
            <h6 class="text-center">
                {{ 'Compilation' | trans }}
                {% if judging.result == 'compiler-error' %}
                    <span class="badge text-bg-danger">{{ 'failed' | trans }}</span>
                {% else %}
                    <span class="badge text-bg-success">{{ 'successful' | trans }}</span>
                {% endif %}
                {{ 'with the following output' | trans }}
            </h6>
            {% if judging.outputCompile(true) is not empty %}
                <pre class="output_text pre-scrollable">{{ judging.outputCompile(true) }}</pre>
            {% else %}
                <p class="nodata">{{ 'There were no compiler errors or warnings.' | trans }}</p>
            {% endif %}
        {% endif %}

        {% if showSampleOutput and judging.result != 'compiler-error' %}
            <hr/>
            <h4 class="text-center">{{ 'Run(s) on the provided sample data' | trans }}</h4>

            {% if runs is empty %}
                <p class="nodata">{{ 'No sample cases available.' | trans }}</p>
            {% else %}
                {% for run in runs %}
                    <h5 id="run-{{ run.0.rank }}" class="text-center mt-4">{{ 'Run %rank%' | trans({'%rank%': run.0.rank}) }}</h5>

                    {% set judgingRun = run.0.judgingRuns.first %}
                    {% if judgingRun == null or judgingRun.runresult == null %}
                        <p class="nodata">{{ 'Run not finished yet.' | trans }}</p>
                    {% else %}
                        <div class="row">
                            <div class="col-md-{{ size|default(4) }}">
                                <table class="table table-sm table-striped">
                                    <tr>
                                        <th>{{ 'Description' | trans }}</th>
                                        <td>{{ run.0.description(true) }}</td>
                                    </tr>
                                    <tr>
                                        <th>{{ 'Runtime' | trans }}</th>
                                        <td>{{ judgingRun.runtime }} {{ 'sec' | trans }}</td>
                                    </tr>
                                    <tr>
                                        <th>{{ 'Result' | trans }}</th>
                                        <td>
                                            {{ judgingRun.runresult | printResult }}
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        {% if judging.submission.problem.combinedRunCompare %}
                            <h6 class="mt-3">{{ 'Jury/Submission interaction' | trans }}</h6>
                            {% if run.output_run is empty %}
                                <p class="nodata">{{ 'There was no interaction log.' | trans }}</p>
                            {% else %}
                                {{ run.output_run | interactiveLog(true) }}
                            {% endif %}
                            {% if run.team_message is not empty %}
                                <h6 class="mt-3">{{ 'Judge message' | trans }}</h6>
                                <pre class="output_text">
{{  run.team_message }}</pre>
                            {%  endif %}
                        {% else %}
                            <h6 class="mt-3">{{ 'Program output' | trans }}</h6>
                            {% if run.output_run is not empty %}
                                <pre class="output_text">
{{ run.output_run }}</pre>
                            {% else %}
                                <p class="nodata">{{ 'There was no program output.' | trans }}</p>
                            {% endif %}

                            {% if run.team_message is not empty %}
                                <h6 class="mt-3">{{ 'Judge message' | trans }}</h6>
                                <pre class="output_text">
{{  run.team_message }}</pre>
                            {%  endif %}

                            <h6 class="mt-3">{{ 'Error output (info/debug/errors)' | trans }}</h6>
                            {% if run.output_error is not empty %}
                                <pre class="output_text">
{{ run.output_error }}</pre>
                            {% else %}
                                <p class="nodata">{{ 'There was no stderr output.' | trans }}</p>
                            {% endif %}
                        {% endif %}
                    {% endif %}
                {% endfor %}
            {% endif %} {# not runs is empty #}
        {% endif %} {# showSampleOutput and judging.result != 'compiler-error' #}
    </div>
{% endif %} {# not (judging is empty or judging.submission.submittime >= current_team_contest.endtime or (verificationRequired and not judging.verified)) #}
