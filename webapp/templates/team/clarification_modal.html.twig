{% extends "partials/modal.html.twig" %}

{% block title %}
{% if clarification.sender and clarification.sender.teamid == team.teamid %}
{{ 'Clarification Request' | trans }}
{% else %}
{{ 'View message' | trans }}
{% endif %}
{% endblock %}

{% block content %}
    {% include 'team/partials/clarification_content.html.twig' %}
{% endblock %}
{% block extraButton %}
        <button class="btn btn-secondary" data-bs-toggle="collapse" data-bs-target="#collapsereplyform"
                aria-expanded="false" aria-controls="collapsereplyform" id="clarification-reply-button">
            <i class="fa fa-reply"></i> {{ 'reply to this clarification' | trans }}
        </button>
{% endblock %}
