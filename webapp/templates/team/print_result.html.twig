{% extends "team/base.html.twig" %}

{% block title %}{{ parent() }} - {{ 'Print' | trans }}{% endblock %}

{% block extrahead %}
    {{ parent() }}
{% endblock %}

{% block content %}

    <div class="container pt-5">
        <h1 class="text-center">{{ 'Print source' | trans }}</h1>

        <pre class="output_text m-3">
{{ output }}
</pre>

        {% if success %}
            <div class="alert alert-success">{{ 'File has been printed' | trans }}</div>
        {% else %}
            <div class="alert alert-danger">{{ 'Error while printing. Contact staff.' | trans }}</div>
        {% endif %}

        <a href="./" class="btn btn-secondary mt-3">{{ 'Close' | trans }}</a>
    </div>

{% endblock %}
